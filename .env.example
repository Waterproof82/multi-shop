  # =============================================================================                                                                                                                                
  # multi_shop — Variables de entorno                                                                                                                                                                            
  # Copiar este archivo como .env.local para desarrollo local.                                                                                                                                                   
  # NUNCA commitear .env.local ni ningún archivo con valores reales.        
  # =============================================================================                                              
                                                                      
  # Supabase                                                            
  NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co                                                                
  NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key                                             
  SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
                                                                      
  # Autenticación — generar con: openssl rand -hex 32                   
  ACCESS_TOKEN_SECRET=replace-with-64-char-hex-secret                           
  CSRF_HMAC_SECRET=replace-with-64-char-hex-secret                  
  UNSUBSCRIBE_HMAC_SECRET=replace-with-64-char-hex-secret           
  RESERVA_HMAC_SECRET=replace-with-64-char-hex-secret
  WAITER_PIN_PEPPER=replace-with-64-char-hex-secret                           
                                                                                 
  # Upstash Redis (rate limiting / token revocation)                
  UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
  UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

  # CORS
  CORS_ALLOWED_DOMAINS=localhost:3000

  # Email (Brevo)
  BREVO_API_KEY=xkeysib-your-brevo-api-key
  BREVO_DEFAULT_SENDER_EMAIL=noreply@yourdomain.com

  # Cloudflare R2
  R2_ACCOUNT_ID=your-cloudflare-account-id
  R2_ACCESS_KEY_ID=your-r2-access-key-id
  R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
  R2_BUCKET_NAME=your-bucket-name
  R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
  R2_BACKUP_BUCKET_NAME=your-backup-bucket-name
  CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
  NEXT_PUBLIC_R2_DOMAIN=https://assets.yourdomain.com

  # Cron jobs — generar con: openssl rand -hex 32
  CRON_SECRET=replace-with-64-char-hex-secret
  BACKUP_SECRET=replace-with-64-char-hex-secret

  # Telegram
  TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
  TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret

  # Glovo
  GLOVO_WEBHOOK_SECRET=your-glovo-webhook-secret
  GLOVO_MOCK_MODE=true

  # Redsys (URL de test — cambiar en prod)
  NEXT_PUBLIC_REDSYS_URL=https://sis-t.redsys.es:25443/sis/realizarPago

  # Mapbox
  NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VyIn0.your-mapbox-token

  # Sentry (DSN es público por diseño)
  NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

  # Multi-tenant
  BASE_DOMAIN=localhost:3000

  # Electron auto-update
  ELECTRON_VERSION=1.0.0
  ELECTRON_SHA512=
  ELECTRON_RELEASE_DATE=

  # Capacitor Android
  APP_VERSION=1.0.0
  APP_VERSION_CODE=1